{
  "name": "cerase-acp",
  "version": "0.4.0-dev",
  "description": "In-house multi-channel chat bridge for Cerase. DM-only across Discord / Telegram / Slack / Google Workspace Chat. One long-lived ACP session per (user, agent), colleague-style UX.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check src && tsc --noEmit",
    "lint:biome": "biome check src",
    "format": "biome check --write src",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.28.1",
    "@slack/bolt": "^4.7.3",
    "discord.js": "^14.27.0",
    "googleapis": "^173.0.0",
    "pino": "^10.3.1",
    "telegraf": "^4.16.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^20.19.43",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "form-data": ">=4.0.6",
    "undici": ">=6.28.0 <7"
  }
}
